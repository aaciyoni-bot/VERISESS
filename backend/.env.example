# =========================================================
# VeriSess Backend — סודות (Stripe + Twilio)
# =========================================================
# העתק ל-backend/.env ומלא. הקובץ .env לא נכנס לגיט (ראה .gitignore).

# Stripe — מפתח סודי (sk_test_... בבדיקות, sk_live_... בפרודקשן)
STRIPE_SECRET_KEY=

# Twilio — התראות SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# פורט השרת
PORT=3001
