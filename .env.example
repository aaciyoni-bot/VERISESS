# =========================================================
# VeriSess — קונפיגורציית Firebase (Frontend)
# =========================================================
# העתק קובץ זה ל-.env ומלא את הערכים מ-Firebase Console:
#   Project settings → General → Your apps → SDK setup and configuration
#
# apiKey ציבורי במכוון — מותר שיהיה חשוף (מוגן ע"י חוקי Firestore).
# בכל זאת אנחנו מזריקים אותו מ-.env ולא מקבעים בקוד.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=verisess-43aa7.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=verisess-43aa7
VITE_FIREBASE_STORAGE_BUCKET=verisess-43aa7.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
