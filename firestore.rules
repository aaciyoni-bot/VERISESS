rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'aaci.yoni@gmail.com'; }

    // אזור נתונים ציבורי לפגישות, צ'אט וסיגנלינג WebRTC (offer/answer/ICE).
    // דורש התחברות (כולל אנונימית) — האפליקציה מתחברת אוטומטית בעלייה.
    match /artifacts/{appId}/public/data/{document=**} {
      allow read, write: if signedIn();
    }

    // חדרי וידאו 1-על-1 (סיגנלינג WebRTC)
    match /rooms/{roomId} {
      allow read, write: if signedIn();
      match /{sub=**} { allow read, write: if signedIn(); }
    }

    // פרופילי מומחים: קטלוג ציבורי; עריכה לבעלים; status (KYC) למנהל בלבד
    match /providers/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && request.resource.data.status == 'pending';
      allow update: if isOwner(uid)
                    && request.resource.data.status == resource.data.status;
      allow update, delete: if isAdmin();
    }
    match /providers/{uid}/availability/{slotId} {
      allow read: if true;
      allow create, delete: if isOwner(uid) || isAdmin();
      // לקוח מחובר יכול לסמן מועד כתפוס בעת הזמנה (פיילוט)
      allow update: if signedIn();
    }

    // ---- ארנק הטוקנים (1 טוקן = 1 ₪) ----
    // פיילוט: פעולות רצות מהדפדפן. להדק ל-`if false` בשלב Cloud Functions.
    match /wallets/{uid} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /wallet_ledger/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;      // append-only
    }
    match /wallet_holds/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }
    match /wallet_payouts/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    // הזמנות
    match /bookings/{id} {
      allow read, write: if signedIn();
    }

    // יומן רגשי — פרטי לחלוטין לבעלים בלבד
    match /journals/{id} {
      allow read, update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // מועדפים — דוק אחד לכל משתמש
    match /favorites/{uid} {
      allow read, write: if isOwner(uid);
    }

    // צ'אט אסינכרוני — רק המשתתפים בשיחה
    match /messages/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update, delete: if false;
    }
    match /threads/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow write: if signedIn() && request.auth.uid in request.resource.data.participants;
    }

    // ביקורות ודירוגים — קריאה ציבורית, יצירה למשתמש מחובר, ללא עריכה/מחיקה
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    // התראות — הנמען קורא/מעדכן (סימון כנקרא); כל מחובר יכול ליצור התראה לנמען
    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn();
      allow delete: if false;
    }

    // התראות Trust & Safety — יצירה למחובר, קריאה/עדכון למנהל בלבד
    match /alerts/{id} {
      allow create: if signedIn();
      allow read, update: if isAdmin();
      allow delete: if false;
    }
  }
}
